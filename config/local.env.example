# Local workstation configuration. Copy to `config/local.env` and edit.
# `config/local.env` is gitignored; this template holds placeholders only.
#
#   Linux / macOS:   set -a && . config/local.env && set +a
#   Windows PowerShell:
#       Get-Content config/local.env | ForEach-Object {
#           if ($_ -match '^\s*([A-Z_]+)=(.*)$') { [Environment]::SetEnvironmentVariable($M[1], $M[2]) } }

# Directory holding the prepared inputs. Everything below is looked up here by
# name unless an experiment is given an explicit --flag override.
#
#   train_labels.csv        uid,is_pathologic  (1362 rows, as distributed)
#   volume_cache.npy        (1362, 80, 80, 80) float16 or float32
#   acquisition_group.npy   (1362,) int   acquisition cluster per case
#   original_fold.npy       (1362,) int   outer fold per case
#   oof_probability.npy     (1362,) float out-of-fold probability (experiment 2)
DAT_DATA_ROOT=/path/to/dat/data

# Writable directory for the sanitized JSON contracts each experiment emits.
DAT_OUTPUT_ROOT=/path/to/dat/runs

# Experiment 3 only. A local DINOv3 checkpoint; it is never downloaded, and the
# run stops rather than reaching for the network if this is unset.
DAT_DINOV3_WEIGHTS=/path/to/models/dinov3.pth
